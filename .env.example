# Backend API URL (without trailing slash)
# Local dev: http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Google OAuth client ID (frontend). Must match the backend GOOGLE_CLIENT_ID.
# Required for Google sign-in. Set this in your build env (or .env.production).
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# --- Backend only: see server/.env (git-ignored) ---------------------------
# LinkedIn API credentials + target page live in server/.env, NOT in this file.
# Required variables for LinkedIn automation:
#   LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET
#   LINKEDIN_ACCESS_TOKEN            (OAuth bearer token)
#   LINKEDIN_PAGE_URN                (urn:li:organization:<id>, preferred)
#   LINKEDIN_PERSON_URN              (fallback author: urn:li:member:<id>)
#   LINKEDIN_SEVERITY_THRESHOLD      (default 0.7)
# ---------------------------------------------------------------------------